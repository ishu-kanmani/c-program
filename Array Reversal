#include <stdio.h>
#include <stdlib.h>

int main() {
    int num, i;
    // Read the size of the array
    if (scanf("%d", &num) != 1) return 1;
    
    int *arr = (int*) malloc(num * sizeof(int));
    
    // Read the array elements
    for(i = 0; i < num; i++) {
        if (scanf("%d", &arr[i]) != 1) return 1;
    }

    /* Write the logic to reverse the array. */
    int start = 0;
    int end = num - 1;
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }

    // Print the reversed array
    for(i = 0; i < num; i++)
        printf("%d ", arr[i]);
        
    free(arr);
    return 0;
}

