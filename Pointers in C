
#include <stdio.h>
#include <stdlib.h> // For the abs() function

void update(int *a, int *b) {
    // Store original values in temporary variables
    int temp_a = *a;
    int temp_b = *b;

    // Set the value of a to the sum
    *a = temp_a + temp_b;

    // Set the value of b to the absolute difference
    *b = abs(temp_a - temp_b);
}

int main() {
    int a, b;
    int *pa = &a, *pb = &b;

    scanf("%d %d", &a, &b);
    update(pa, pb);
    printf("%d\n%d", a, b);

    return 0;
}
