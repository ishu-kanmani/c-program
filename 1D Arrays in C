#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    long long sum = 0; 
    
    scanf("%d", &n);
   
    int *arr = (int*)malloc(n * sizeof(int));
    
    if (arr == NULL) {
        return 1; 
    }
    
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    for (i = 0; i < n; i++) {
        sum += arr[i];
    }
    
    printf("%lld\n", sum);
    
    free(arr);
    
    return 0;
}


