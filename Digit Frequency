#include <stdio.h>
#include <string.h>
int main() {
    char s[1001]; 
    int digit_counts[10] = {0}; 
    scanf("%1000s", s); 
    for (int i = 0; s[i] != '\0'; i++) {
        
        if (s[i] >= '0' && s[i] <= '9') {
          
            digit_counts[s[i] - '0']++; 
        }
    }
    for (int i = 0; i < 10; i++) {
        printf("%d ", digit_counts[i]);
    }
    printf("\n"); 
    return 0;
}

